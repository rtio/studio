{
	"name": "@studio/mobile",
	"private": true,
	"version": "0.1.0",
	"description": "Studio's phone app: a remote for Studio Code (Expo / React Native)",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start --dev-client --port 8097",
		"ios": "expo run:ios --port 8097",
		"android": "expo run:android --port 8097",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"expo": "~58.0.25",
		"expo-build-properties": "~58.0.12",
		"expo-constants": "~58.0.16",
		"expo-dev-client": "~58.0.20",
		"expo-linking": "~58.0.17",
		"expo-router": "~58.0.31",
		"expo-status-bar": "~58.0.5",
		"expo-system-ui": "~58.0.7",
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-worklets": "0.13.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.15"
	}
}
