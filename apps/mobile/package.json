{
	"name": "@studio/mobile",
	"private": true,
	"version": "0.1.0",
	"description": "Studio's phone app: a remote for Studio Code (Expo / React Native)",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start --dev-client --localhost --port 8097",
		"tokens": "node scripts/generate-tokens.mjs",
		"logo": "node scripts/render-logo.mjs",
		"ios": "expo run:ios --no-bundler",
		"android": "expo run:android --no-bundler",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@expo-google-fonts/inter": "^0.4.2",
		"@expo/ui": "~58.0.28",
		"@studio/agent": "file:../../packages/agent",
		"@tanstack/react-query": "^5.75.5",
		"@wordpress/i18n": "^6.30.0",
		"expo": "~58.0.25",
		"expo-blur": "~58.0.6",
		"expo-build-properties": "~58.0.12",
		"expo-camera": "~58.0.14",
		"expo-clipboard": "~58.0.4",
		"expo-constants": "~58.0.16",
		"expo-dev-client": "~58.0.20",
		"expo-font": "~58.0.12",
		"expo-glass-effect": "~58.0.5",
		"expo-haptics": "~58.0.8",
		"expo-linking": "~58.0.17",
		"expo-router": "~58.0.31",
		"expo-secure-store": "~58.0.3",
		"expo-splash-screen": "~58.0.14",
		"expo-status-bar": "~58.0.5",
		"expo-system-ui": "~58.0.7",
		"lucide-react-native": "^1.48.0",
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-drawer-layout": "^4.2.12",
		"react-native-enriched-markdown": "^1.2.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "^15.16.0",
		"react-native-worklets": "0.13.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/react": "^19.2.15",
		"playwright": "^1.64.1"
	},
	"enriched-markdown": {
		"enableCodeHighlight": false,
		"enableMath": false,
		"enableVideo": false
	}
}
